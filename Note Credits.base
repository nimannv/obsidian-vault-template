filters:
  and:
    - file.folder == "my-notes"
formulas:
  du: (number(now()) - number(date(updated.toString().slice(0, 19).replace("T", " ")))) / 86400000
  dv: (number(now()) - number(date(viewed.toString().slice(0, 19).replace("T", " ")))) / 86400000
  d: (formula.du + formula.dv) / 2
  M: if(maturity == "baby", 0.25, if(maturity == "young", 0.5, if(maturity == "adult", 0.75, 1)))
  H: if(maturity == "baby", 7, if(maturity == "young", 30, if(maturity == "adult", 90, 365)))
  y: 0.693 * formula.d / formula.H
  decay: 1 / (1 + formula.y * (1 + formula.y * (0.5 + formula.y * (1/6 + formula.y / 24))))
  credit: if(status == "inactive", 0, (100 * formula.M * formula.decay).round())
properties:
  formula.credit:
    displayName: Credit
views:
  - type: table
    name: Note Credits
    order:
      - file.name
      - maturity
      - formula.credit
      - tags
    sort:
      - property: formula.credit
        direction: DESC
    columnSize:
      file.name: 176
